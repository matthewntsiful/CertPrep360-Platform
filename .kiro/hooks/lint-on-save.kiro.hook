{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs ESLint on TypeScript/TSX files when they are saved in the website directory to catch issues early.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "website/src/**/*.ts",
      "website/src/**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd website && npm run lint"
  }
}