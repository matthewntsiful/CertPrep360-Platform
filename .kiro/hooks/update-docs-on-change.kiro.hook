{
  "enabled": true,
  "name": "Update Docs on Source Change",
  "description": "When source files (TypeScript, JavaScript, Terraform, config files) are edited, asks the agent to update relevant documentation in README.md or the docs/ folder to keep documentation in sync with code changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx",
      "*.js",
      "*.mjs",
      "*.tf",
      "*.json",
      "*.yml",
      "*.yaml",
      "vite.config.ts",
      "vitest.config.ts",
      "tsconfig.json",
      "package.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if it affects any documented behavior, APIs, commands, architecture, or configuration. If so, update the relevant documentation in README.md, QUICK_START.md, or files in the docs/ folder to reflect the change. Keep docs concise and accurate. If the change is trivial (formatting, comments, minor refactors with no behavioral impact), no doc update is needed."
  }
}