{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "Runs the frontend test suite after a spec task is completed to verify nothing broke.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "cd website && npm run test"
  }
}