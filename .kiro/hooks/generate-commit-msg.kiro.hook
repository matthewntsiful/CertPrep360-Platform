{
  "enabled": true,
  "name": "Generate Commit Message",
  "description": "Manually triggered hook that analyzes the current git diff and generates a conventional commit message (feat/fix/chore/docs prefix).",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `git diff --staged` (or `git diff` if nothing is staged). Analyze the changes and generate a conventional commit message following this format: type(scope): description. Types: feat, fix, docs, chore, refactor, test, style. Keep the subject line under 72 characters. Add a body if the change is complex. Present the suggested commit command."
  }
}